[Unit]
Description=Telegram Signal Forwarder (BTC HA Strategy)
After=network.target

[Service]
WorkingDirectory=/root/mentor4trading_bot_signale
ExecStart=/usr/bin/python3 telegram_signal_bot.py
Restart=always
RestartSec=5
EnvironmentFile=/root/mentor4trading_bot_signale/.env
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target

